entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"
    transport:
      respondingTimeouts:
        readTimeout: 0

providers:
  file:
    directory: /etc/traefik/dynamic
    watch: true

accessLog: {}

log:
  level: {{ traefik_stack_log_level }}
